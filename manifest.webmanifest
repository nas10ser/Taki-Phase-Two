{
  "name": "TAKI - عروض وحصريات",
  "short_name": "TAKI",
  "description": "منصة تكي للعروض والخصومات الحصرية في منطقتك",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./?source=pwa",
  "scope": "./",
  "id": "/?source=pwa",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "orientation": "portrait-primary",
  "categories": [
    "shopping",
    "lifestyle",
    "business"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "/logo192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/logo512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "العروض القريبة",
      "short_name": "حولي",
      "description": "اكتشف أقرب التخفيضات حولك",
      "url": "/nearby",
      "icons": [
        {
          "src": "/logo192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "حجوزاتي",
      "short_name": "حجوزاتي",
      "description": "إدارة حجوزاتك النشطة",
      "url": "/bookings",
      "icons": [
        {
          "src": "/logo192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "./screenshots/home.png",
      "sizes": "540x1170",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "الصفحة الرئيسية — عروض اليوم قريبة منك"
    },
    {
      "src": "./screenshots/deals.png",
      "sizes": "540x1170",
      "type": "image/png",
      "form_factor": "narrow",
