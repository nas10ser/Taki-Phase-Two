# عناوين رسائل GoTrue — قوالب Go قصيرة، ثنائية اللغة.
# ⚠️ هذه نسخة مرجعية فقط. المصدر الحيّ هو docker-compose.taki.yml على جدة،
#    لأن GoTrue يقرأ العناوين من متغيّر بيئة لا من ملف. عدّلهما معاً.
# المقدّمة نفسها المستعملة في ملفات .html: الافتراضي عربي.

GOTRUE_MAILER_SUBJECTS_CONFIRMATION={{ $en := false }}{{ if .Data }}{{ if .Data.lang }}{{ if eq (print .Data.lang) "en" }}{{ $en = true }}{{ end }}{{ end }}{{ end }}{{ if $en }}Confirm your email address{{ else }}أكِّد بريدك الإلكتروني{{ end }}
GOTRUE_MAILER_SUBJECTS_RECOVERY={{ $en := false }}{{ if .Data }}{{ if .Data.lang }}{{ if eq (print .Data.lang) "en" }}{{ $en = true }}{{ end }}{{ end }}{{ end }}{{ if $en }}Reset your password{{ else }}إعادة تعيين كلمة المرور{{ end }}
GOTRUE_MAILER_SUBJECTS_EMAIL_CHANGE={{ $en := false }}{{ if .Data }}{{ if .Data.lang }}{{ if eq (print .Data.lang) "en" }}{{ $en = true }}{{ end }}{{ end }}{{ end }}{{ if $en }}Confirm your new email address{{ else }}أكِّد بريدك الإلكتروني الجديد{{ end }}
