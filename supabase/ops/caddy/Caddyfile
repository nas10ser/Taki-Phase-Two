# 🔴 v15.79 — اسمٌ حرفيٌّ واحد، لا متغيّرُ بيئةٍ لا يقرؤه أحد (S8-07).
#
# كان السطرُ `{$PROXY_DOMAIN}, api.takisa.net {` و`PROXY_DOMAIN` ما زال يحمل
# الاسمَ القديم المبنيَّ على رقم **الجهاز السابق** عبر sslip.io (خدمةُ أسماءٍ
# تُثبّت كلَّ اسمٍ على الرقم المكتوب فيه). وذلك الجهازُ تركناه في ١٩ أكتوبر
# وقد تُسنده أوراكل لأيّ عميلٍ آخر. فكانت Caddy تُحاول تجديدَ شهادةٍ لمضيفٍ
# ليس لنا كلَّ ست ساعاتٍ **منذ الانتقال**، وتفشل في `tls-alpn-01` ثمّ
# `http-01`، وتُعيد المحاولة أبداً. وكلفتُه ليست معالجاً بل **قناةً تُدرَّب
# على التجاهل**: سجلٌّ يصرخ كلَّ ست ساعاتٍ عن شيءٍ لا يملك أحدٌ إصلاحَه هو
# السجلُّ الذي لن يُقرأ يومَ يكسر تجديدُ `api.takisa.net` نفسُه. (نفسُ درس
# v15.24: إنذارٌ لا يُفعل به شيء ليس إنذاراً.) وكان الاسمُ القديم **منفذاً
# قائماً** أيضاً: طلبٌ بترويسةِ `Host` تحمله إلى عنواننا كان يُوجَّه إلى
# Studio فيردّ ٤٠١ بدل أن يسقط في الافتراضيّ الفارغ.
#
# 🪤 ولا يُكتب الاسمُ الميتُ هنا حرفياً: `scripts/check-dead-host.js` صار يفحص
#    هذا الملفَّ (كان بلا امتدادٍ فخارجَ مداه)، وكتابتُه تُفشل البناءَ بحقّ.
#
# 🪤 ويبقى الاسمُ القديم في `TRUSTED_ISSUER_HOSTS` بـ`src/services/supabaseClient.ts`
#    **ولا يُمَسّ**: تلك قائمةُ قَبولِ مُصدِري توكن تُقرَّر بها **إزالةُ** جلسةٍ
#    محليّة، لا منحٌ شبكيّ — وإسقاطُها يُخرج جلساتَ ما قبل ١٩ أكتوبر بصفر مكسب.
# 🪤 ولا يعود `{$PROXY_DOMAIN}` إلى هذا السطر: عنوانُ الموقع يُقرأ من متغيّرٍ
#    لا يراه أحدٌ في مراجعةٍ، وقيمةٌ فارغةٌ فيه تُنتج `, api.takisa.net {` أي
#    خطأَ صيغةٍ يُسقط الوسيطَ كلَّه. و`scripts/check-dead-host.js` يرفضه الآن.
api.takisa.net {
    @supabase_api path /auth/v1/* /rest/v1/* /graphql/v1 /realtime/v1/* /storage/v1/* /functions/v1/* /mcp /sso/*

    # ردودٌ تحمل هويّةَ صاحبها — لا تُخزَّن على الجهاز أبداً (S8-03).
    # 🪤 و`/storage/v1/object/public/*` **خارجها عمداً**: صورُ العروض ثابتةٌ
    #    وترويستُها سنةٌ كاملة، وإدخالُها هنا يقتل تخزينَ كلِّ صورةٍ في المنصّة.
    # 🪤 وسطرٌ واحدٌ بلا `\`: استمرارُ السطر بالشرطة المائلة يعمل في Caddyfile
    #    لكنّه لا يُقاس من هنا (لا ثنائيّةَ caddy على جهاز ناصر)، وسطرٌ طويلٌ
    #    مضمونٌ أرخصُ من صيغةٍ تُسقط الوسيطَ كلَّه عند `reload`.
    @authed path /rest/v1/* /auth/v1/* /graphql/v1 /functions/v1/* /storage/v1/object/sign/* /storage/v1/object/authenticated/* /storage/v1/object/upload/*

    # v15.51 — الضغط. قِيس قبله: ٣٤٬٣٤٦ بايتاً تُرسَل **خاماً** حتى حين يطلب
    # المتصفّحُ `gzip,br,zstd` — صفرُ ترويسةِ `content-encoding` في الردّ.
    # وبـgzip تصير ٥٬٤٦٥ (٦٫٣×). وهو أرخصُ مكسبِ سعةٍ على المنصّة كلّها:
    # يرفع جدارَ النطاق الترددي من ~٧٦ ألف متصلٍ إلى ~٤٨٠ ألفاً بسطرٍ واحد.
    # 🪤 ولا تُضغط الصورُ: `encode` يتخطّى ما هو مضغوطٌ أصلاً بالنوع.
    encode {
        zstd
        gzip 6
        minimum_length 512
    }

    # ═════════════════════════════════════════════════════════════════════
    # 🔴 v15.79 — ترويساتُ الأمان على أصل القاعدة (S8-02 · S8-03)
    # ═════════════════════════════════════════════════════════════════════
    # قِيس على الإنتاج: `api.takisa.net` كان يردّ **بلا أيّ ترويسة أمان**
    # — ولا ترويسةَ تخزينٍ على ردود PostgREST الموثَّقة. فردُّ
    # `/rest/v1/bookings?select=*` (اسمُ المشتري وجوّالُه وعنوانُه) يأتي بلا
    # `Cache-Control` ولا `Expires` ولا `Pragma`، وذاك **مؤهَّلٌ للتخزين
    # التقديريّ** في ذاكرة القرص (RFC 9111 §4.2.2)، و`signOut()` يمسح
    # `localStorage` وحده. أي أن جهازاً مشتركاً (جوّالُ عائلةٍ، لوحُ محلٍّ على
    # الكاونتر — وهو الحالةُ الطبيعيّة لهذا المنتَج) قد يُعيد بياناتَ المشتري
    # السابق بعد خروجه.
    #
    # 🪤 وموضعُ الكتلة لا يُقرَّر بترتيب الملفّ: Caddy تُرتّب التوجيهات بترتيبٍ
    #    ثابتٍ من عندها، و`header` يسبق `handle`/`reverse_proxy` فيلفّ الردَّ
    #    القادمَ من الوسيط. والدليلُ مقيسٌ لا مفترض: `header -server` كان
    #    مكتوباً في **آخر** الكتلة وهو يعمل فعلاً (صفرُ ترويسةِ `Server` في
    #    ردود الإنتاج). ولذلك تكفي كتلةٌ واحدةٌ هنا لكلّ ما يخرج من الوسيط.
    header {
        -server

        # سنتان. 🪤 وبلا `preload`: ذلك الوسمُ لا معنى له إلّا على الجذر
        #    المُسجَّل في قائمة المتصفّحات، و«ادّعاءٌ لا ينفّذ شيئاً» مخالفةٌ
        #    عندنا. تسجيلُ `takisa.net` هو ما يحمي، لا الكلمة.
        Strict-Transport-Security "max-age=63072000; includeSubDomains"

        # لا يُخمَّن نوعُ المحتوى. 🪤 وهو آمنٌ هنا لأن أنواعَ المستودعات
        #    محصورةٌ بـ`image/*` (+`application/pdf` للشكاوى)، فلا ملفَّ
        #    يعتمد على التخمين ليُعرَض.
        X-Content-Type-Options "nosniff"

        # هذا الأصلُ يخدم لوحةَ Studio أيضاً، فلا يخرج منها عنوانٌ في Referer.
        Referrer-Policy "no-referrer"

        # 🔴 `cross-origin` وليس `same-origin` — والفرقُ هو كلُّ صورةٍ في
        #    المنصّة: صورُ العروض تُطلب من `www.takisa.net` وهي من أصلٍ آخر،
        #    فـ`same-origin` هنا (وهي قيمةُ `vercel.json` للموقع) تُفرّغ كلَّ
        #    بطاقةٍ وكلَّ صفحةِ عرضٍ في اللحظة نفسِها. وقيمتُها الأمنيّةُ
        #    إعلانيّةٌ لا مانعة: تجعل المورد صالحاً لسياقٍ يفرض COEP لاحقاً.
        Cross-Origin-Resource-Policy "cross-origin"
    }

    header @authed Cache-Control "no-store, private"

    handle @supabase_api {
        reverse_proxy kong:8000
    }

    # قوالب بريد GoTrue - يجلبها الخادم نفسه عبر HTTPS. عامّة عمداً (لا أسرار
    # فيها، مجرد HTML) ولا بد أن تبقى خارج basic_auth، وإلا فشل الجلب وعاد
    # GoTrue لقوالبه الإنجليزية بصمت.
    handle_path /email-templates/* {
        root * /etc/caddy/email-templates
        file_server
    }

    # 🔴 **لوحةُ Studio أُغلقت عن الإنترنت — قرارُ ناصر، ١٠ نوفمبر ٢٠٢٦.**
    #
    # كانت هذه الكتلةُ تُمرّر كلَّ مسارٍ غيرِ مطابقٍ أعلاه إلى `studio:3000`
    # خلف Basic Auth — أي أن **واجهةَ إدارةٍ كاملةً للقاعدة فيها محرّرُ SQL**
    # كانت مفتوحةً على الإنترنت، ولا يفصلها عنه إلّا كلمةُ مرورٍ واحدة.
    # وتلك الكلمةُ ظهرت فعلاً في سجلّ جلسةٍ (مرشّحُ تمويهٍ فاشل)، فدُوّرت —
    # ثمّ سأل ناصرٌ: «لا أستخدمها، أغلقها». وإسقاطُ السطح أقوى من حراسته.
    #
    # 🪤 ولا تُحذف الكتلةُ حذفاً: بلا `handle` أخيرة يردّ Caddy على المسارات
    #    غيرِ المطابقة بـ200 وجسمٍ فارغ، فيبدو المضيفُ حيّاً بلا سبب. و404
    #    جوابٌ صريح. (والمساراتُ الحقيقيّة كلُّها مطابَقةٌ أعلاه: `@supabase_api`
    #    و`/email-templates/*` — فلا شيءَ من المنصّة يمرّ من هنا.)
    #
    # 🔑 وللوصول إليها عند الحاجة — نفقُ SSH من جهاز ناصر، ولا شيءَ مكشوف:
    #      ssh -i ~/.ssh/taki_jeddah2 -L 3000:172.20.0.4:3000 ubuntu@207.127.99.122
    #    ثمّ يُفتح  http://localhost:3000  في المتصفّح.
    #    (172.20.0.4 عنوانُ حاوية `supabase-studio` في شبكة دوكر — يُقرأ بـ
    #     `sudo docker inspect supabase-studio` إن تغيّر.)
    handle {
        respond 404
    }
}

# ═══════════════════════════════════════════════════════════════════════════
# 🖼 img.takisa.net — مضيفُ الصور وحده، خلف شبكة Cloudflare
# ═══════════════════════════════════════════════════════════════════════════
# لماذا مضيفٌ ثانٍ ولا نُوكِّل `api` نفسَه: توكيلُ `api` يُمرّر **قاعدةَ
# البيانات والمصادقةَ والبثَّ الحيَّ ودوالَّ الحافة** عبر وسيطٍ ثالث، ويغيّر
# مسارَ الشهادة ومسارَ WebSocket معاً. ومضيفٌ للصور وحدها يأخذ كلَّ المكسب
# (البايتاتُ تخرج من نواةٍ واحدةٍ في جدة إلى حافةٍ عالميّة) بصفر مخاطرةٍ على
# ما سواه.
#
# 🔒 والسطحُ **أضيقُ ما يمكن**: `deals` هو المستودعُ العامّ الوحيد (قِيس:
#    `chat` و`complaints` خاصّان)، فالمسارُ محصورٌ به وحده، والطريقةُ
#    GET/HEAD وحدهما. وكلُّ ما عداه — rest · auth · functions · realtime ·
#    قوالبُ البريد — **لا يُوجَد على هذا الاسم إطلاقاً**، يردّ 404.
#
# 🪤 ولا تُنشر هذه الكتلةُ قبل أن يُحلّ اسمُ `img.takisa.net` فعلاً: كتلةٌ
#    لمضيفٍ بلا سجلّ DNS تجعل Caddy تطلب شهادةً لا تستطيع إثباتَها فتُعيد
#    المحاولةَ أبداً — وهو العيبُ نفسُه الذي كلّف `{$PROXY_DOMAIN}` أعلاه.
#    و`scripts/setup-image-cdn-caddy.sh` يرفض النشرَ ما لم يُحلّ الاسم.
#
# 🪤 و`img.takisa.net` **خارج** `isOwnBackend` في `sw.js` عمداً: إدخالُه هناك
#    يجعل الخدمةَ العاملة تجلبه بـ`fetch`، و`fetch` داخلها يخضع لـ`connect-src`
#    (لا `img-src`) — و`connect-src` يذكر `api.takisa.net` حرفياً، فتنكسر كلُّ
#    صورةٍ **داخل التطبيق المثبَّت وحده** بينما تعمل في المتصفّح العادي.
img.takisa.net {
    # 🔴 تحدّي HTTP-01 حصراً. السببُ بنيويّ لا تفضيليّ: Caddy تُجرّب
    #    `tls-alpn-01` أوّلاً، وهو تحدٍّ يجري **داخل مصافحة TLS** — وسحابةُ
    #    Cloudflare البرتقاليّة تُنهي TLS عندها، فلا يصل التحدّي الأصلَ أبداً
    #    ويفشل حتماً قبل أن تسقط Caddy إلى `http-01`. وتعطيلُه يجعل الإصدارَ
    #    من أوّل محاولة، ويُبقي سجلَّ Caddy نظيفاً (درسُ `{$PROXY_DOMAIN}`).
    #    و`http-01` يمرّ عبر الوسيط: Cloudflare تستثني
    #    `/.well-known/acme-challenge/*` من «Always Use HTTPS».
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }

    header {
        -server
        Strict-Transport-Security "max-age=63072000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        # صورٌ تُطلب من www.takisa.net — أصلٌ آخر، فلا بدّ من cross-origin.
        Cross-Origin-Resource-Policy "cross-origin"
    }

    # 🪤 ولا `encode` هنا: الصورُ مضغوطةٌ أصلاً، وضغطُها ثانيةً معالجٌ بلا مكسب.

    @images {
        method GET HEAD
        path /storage/v1/object/public/deals/* /storage/v1/render/image/public/deals/*
    }
    handle @images {
        reverse_proxy kong:8000
    }

    handle {
        respond 404
    }
}
